<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" android:orientation="vertical" android:padding="18dp" android:background="@drawable/bg_card">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
  <TextView android:id="@+id/comment_author" style="@style/PF.Body" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textStyle="bold"/>
  <TextView android:id="@+id/comment_time" style="@style/PF.Caption" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
 </LinearLayout>
 <TextView android:id="@+id/comment_body" style="@style/PF.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:textIsSelectable="true"/>
</LinearLayout>