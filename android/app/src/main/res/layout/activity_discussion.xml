<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/main" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
 <LinearLayout android:layout_width="match_parent" android:layout_height="56dp" android:gravity="center_vertical" android:paddingHorizontal="12dp">
  <ImageButton android:id="@+id/discussion_back" android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/ic_back" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="@string/ui_activity_detail_1"/>
  <TextView style="@style/PF.Heading" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/discussion_title"/>
 </LinearLayout>
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
  <TextView android:id="@+id/discussion_paper" style="@style/PF.Title" android:layout_width="match_parent" android:layout_height="wrap_content"/>
  <TextView style="@style/PF.Caption" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/discussion_local"/>
  <TextView android:id="@+id/discussion_count" style="@style/PF.Caption" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp"/>
 </LinearLayout>
 <ScrollView android:id="@+id/discussion_scroll" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="20dp" android:paddingBottom="12dp">
   <TextView android:id="@+id/discussion_empty" style="@style/PF.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="22dp" android:background="@drawable/bg_soft" android:text="@string/discussion_empty"/>
   <LinearLayout android:id="@+id/discussion_list" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/>
  </LinearLayout>
 </ScrollView>
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
  <EditText android:id="@+id/discussion_author" android:layout_width="match_parent" android:layout_height="48dp" android:paddingHorizontal="14dp" android:background="@drawable/bg_search" android:hint="@string/discussion_name" android:inputType="textPersonName" android:singleLine="true" android:maxLength="20" android:textSize="14sp" android:importantForAutofill="no"/>
  <EditText android:id="@+id/discussion_input" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="100dp" android:maxLines="4" android:layout_marginTop="8dp" android:padding="14dp" android:gravity="top|start" android:background="@drawable/bg_search" android:hint="@string/discussion_hint" android:inputType="textMultiLine|textCapSentences" android:maxLength="1000" android:textSize="14sp" android:importantForAutofill="no"/>
  <com.google.android.material.button.MaterialButton android:id="@+id/discussion_send" style="@style/PF.Button" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="@string/discussion_send"/>
 </LinearLayout>
</LinearLayout>