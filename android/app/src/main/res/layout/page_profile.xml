  <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:orientation="vertical"><TextView style="@style/PF.Heading" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ui_page_profile_2"/><TextView style="@style/PF.Caption" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="@string/ui_page_profile_3"/></LinearLayout>
 </LinearLayout>
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:padding="22dp" android:background="@drawable/bg_soft" android:orientation="horizontal">
