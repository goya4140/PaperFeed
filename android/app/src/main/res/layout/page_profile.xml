  <TextView android:id="@+id/stat_notes" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textAlignment="center" android:textSize="19sp" android:textColor="@color/forest"/>
 </LinearLayout>
 <TextView style="@style/PF.Heading" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="30dp" android:text="@string/ui_page_profile_4"/>
 <TextView android:id="@+id/interests_summary" style="@style/PF.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp"/>
 <com.google.android.material.button.MaterialButton android:id="@+id/manage_interests" style="@style/PF.Outline" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="@string/ui_page_profile_5"/>
 <TextView style="@style/PF.Heading" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="26dp" android:text="@string/ui_page_profile_6"/>
 <TextView style="@style/PF.Caption" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/ui_page_profile_7"/>
 <com.google.android.material.button.MaterialButton android:id="@+id/export_markdown" style="@style/PF.Button" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/ui_page_profile_8" app:icon="@drawable/ic_export"/>
 <com.google.android.material.button.MaterialButton android:id="@+id/export_bibtex" style="@style/PF.Outline" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="@string/ui_page_profile_9"/>
 <TextView android:id="@+id/about_button" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="18dp" android:gravity="center_vertical" android:text="@string/ui_page_profile_10" android:textSize="14sp" android:textColor="@color/ink" android:background="?attr/selectableItemBackground"/>
 <TextView style="@style/PF.Caption" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="@string/ui_page_profile_11"/>
