 <com.google.android.material.bottomnavigation.BottomNavigationView android:id="@+id/bottom_nav" android:layout_width="match_parent" android:layout_height="76dp" android:background="@color/paper" app:menu="@menu/bottom_nav" app:labelVisibilityMode="labeled" app:itemIconTint="@color/nav_item" app:itemTextColor="@color/nav_item" android:elevation="0dp"/>
</LinearLayout>
