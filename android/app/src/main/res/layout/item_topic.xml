<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="14dp" android:padding="20dp" android:orientation="vertical" android:background="@drawable/bg_card">
 <TextView android:id="@+id/topic_number" style="@style/PF.Kicker" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
 <TextView android:id="@+id/topic_name" style="@style/PF.Heading" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp"/>
 <TextView android:id="@+id/topic_description" style="@style/PF.Caption" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"/>
