<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/main" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
 <LinearLayout android:layout_width="match_parent" android:layout_height="56dp" android:gravity="center_vertical" android:paddingHorizontal="12dp">
  <ImageButton android:id="@+id/detail_back" android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/ic_back" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="@string/ui_activity_detail_1"/>
  <TextView style="@style/PF.Kicker" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:gravity="center" android:text="@string/ui_activity_detail_2"/>
  <ImageButton android:id="@+id/detail_more" android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/ic_more" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="@string/ui_activity_detail_3"/>
 </LinearLayout>
 <ScrollView android:id="@+id/detail_scroll" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="22dp" android:orientation="vertical" android:focusableInTouchMode="true">
  <TextView android:id="@+id/detail_topic" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/bg_badge" android:paddingHorizontal="10dp" android:paddingVertical="6dp" android:textColor="@color/forest" android:textSize="11sp"/>
  <TextView android:id="@+id/detail_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:textSize="34sp" android:textColor="@color/ink" android:fontFamily="sans-serif-medium"/>
  <TextView android:id="@+id/detail_title" style="@style/PF.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp"/>
  <TextView android:id="@+id/detail_meta" style="@style/PF.Caption" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp"/>
  <TextView android:id="@+id/detail_authors" style="@style/PF.Caption" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:maxLines="3" android:ellipsize="end"/>
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:padding="22dp" android:orientation="vertical" android:background="@drawable/bg_soft">
   <TextView style="@style/PF.Kicker" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ui_activity_detail_4" android:textColor="@color/forest"/>
   <TextView android:id="@+id/detail_summary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:textSize="22sp" android:lineSpacingExtra="7dp" android:textColor="@color/forest" android:fontFamily="sans-serif-medium"/>
  </LinearLayout>
  <com.google.android.material.button.MaterialButton android:id="@+id/speech_button" style="@style/PF.Outline" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/ui_activity_detail_5" app:icon="@drawable/ic_play"/>
  <com.google.android.material.button.MaterialButton android:id="@+id/discussion_button" style="@style/PF.Button" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="@string/discussion_title"/>
  <TextView style="@style/PF.Heading" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="26dp" android:text="@string/ui_activity_detail_6"/><TextView android:id="@+id/detail_question" style="@style/PF.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:textIsSelectable="true"/>
  <TextView style="@style/PF.Heading" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="26dp" android:text="@string/ui_activity_detail_7"/><TextView android:id="@+id/detail_method" style="@style/PF.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:textIsSelectable="true"/>
  <LinearLayout android:id="@+id/flow_steps" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:orientation="vertical"/>
  <TextView style="@style/PF.Heading" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="26dp" android:text="@string/ui_activity_detail_8"/><TextView android:id="@+id/detail_takeaway" style="@style/PF.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:textIsSelectable="true"/>
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:background="@drawable/bg_card" android:padding="18dp" android:orientation="vertical">
   <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ui_activity_detail_9" android:textSize="13sp" android:textColor="@color/forest" android:fontFamily="sans-serif-medium"/>
   <TextView android:id="@+id/detail_caution" style="@style/PF.Caption" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"/>
  </LinearLayout>
  <TextView style="@style/PF.Heading" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="28dp" android:text="@string/ui_activity_detail_10"/>
  <TextView android:id="@+id/note_status" style="@style/PF.Caption" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/ui_activity_detail_11"/>
  <EditText android:id="@+id/note_input" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="148dp" android:layout_marginTop="14dp" android:padding="16dp" android:background="@drawable/bg_search" android:gravity="top|start" android:hint="@string/ui_activity_detail_12" android:textSize="15sp" android:textColor="@color/ink" android:textColorHint="@color/muted" android:inputType="textCapSentences|textMultiLine" android:maxLength="20000" android:importantForAutofill="no"/>
  <com.google.android.material.button.MaterialButton android:id="@+id/save_note" style="@style/PF.Button" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/ui_activity_detail_13"/>
  <com.google.android.material.button.MaterialButton android:id="@+id/folder_button" style="@style/PF.Outline" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/ui_activity_detail_14" app:icon="@drawable/ic_folder"/>
  <TextView style="@style/PF.Heading" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="26dp" android:text="@string/ui_activity_detail_15"/>
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="horizontal">
   <com.google.android.material.button.MaterialButton android:id="@+id/feedback_like" style="@style/PF.Outline" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/ui_activity_detail_16"/>
   <com.google.android.material.button.MaterialButton android:id="@+id/feedback_less" style="@style/PF.Outline" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:text="@string/ui_activity_detail_17"/>
  </LinearLayout>
  <TextView android:id="@+id/source_link" style="@style/PF.Caption" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="26dp" android:paddingVertical="12dp" android:textColor="@color/forest" android:background="?attr/selectableItemBackground"/>
  <TextView style="@style/PF.Caption" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/ui_activity_detail_18"/>
 </LinearLayout></ScrollView>
 <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/line"/>
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingHorizontal="20dp" android:paddingVertical="12dp" android:orientation="horizontal">
  <com.google.android.material.button.MaterialButton android:id="@+id/read_button" style="@style/PF.Outline" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/ui_activity_detail_19" app:icon="@drawable/ic_check"/>
  <com.google.android.material.button.MaterialButton android:id="@+id/favorite_button" style="@style/PF.Button" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:text="@string/ui_activity_detail_20" app:icon="@drawable/ic_bookmark"/>
 </LinearLayout>
</LinearLayout>
