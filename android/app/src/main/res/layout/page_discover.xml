   <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="15dp" android:text="@string/ui_page_discover_3" android:textSize="11sp" android:textColor="#CEE1CE"/>
  </LinearLayout>
  <ImageView android:layout_width="94dp" android:layout_height="112dp" android:layout_gravity="end|center_vertical" android:layout_marginEnd="9dp" android:src="@drawable/ic_cover" android:importantForAccessibility="no"/>
 </FrameLayout>
 <EditText android:id="@+id/search_input" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="18dp" android:background="@drawable/bg_search" android:paddingHorizontal="16dp" android:drawableStart="@drawable/ic_search" android:drawablePadding="10dp" android:hint="@string/ui_page_discover_4" android:textSize="14sp" android:textColor="@color/ink" android:textColorHint="@color/muted" android:inputType="text" android:singleLine="true" android:imeOptions="actionSearch" android:autofillHints=""/>
 <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="15dp" android:scrollbars="none"><LinearLayout android:id="@+id/filter_chips" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingBottom="4dp"/></HorizontalScrollView>
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:gravity="center_vertical">
