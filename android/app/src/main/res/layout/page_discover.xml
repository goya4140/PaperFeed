<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/page_scroll" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:clipToPadding="false"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="20dp" android:paddingBottom="24dp" android:focusableInTouchMode="true">
 <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="190dp" android:layout_marginTop="12dp" android:background="@drawable/bg_hero">
